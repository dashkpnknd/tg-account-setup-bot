# Telegram application credentials (my.telegram.org)
API_ID=
API_HASH=

# Token issued by @BotFather. Never commit the actual value.
BOT_TOKEN=

# Optional comma-separated Telegram user IDs. If blank, the first person to
# press /start becomes the owner. Set this in production to disable bootstrap.
ADMIN_IDS=

# 15 minutes is the delay used by the original full-story copier.
STORY_INTERVAL_MINUTES=15

